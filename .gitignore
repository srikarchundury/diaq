# macOS system files
.DS_Store
docs/.DS_Store

# IDE settings
.vscode/*

# Documentation
docs/.DS_Store/*

# Analysis and benchmarks output
analysis/metrics/*
analysis/benchmarks/*
analysis/metrics*/*
analysis/*metrics*/*

benchmarks/bench
benchmarks/tool/*

# Build directories
cpu_build/
gpu_build/
cpu_build_sse/
cpu_build_avx/

# CMake build artifacts (inside any build folder)
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/Makefile

# Python build artifacts
diaq.egg-info/
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled Objects & Libraries
*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib
*.la
*.lai
*.slo
*.lo

# Precompiled headers
*.gch
*.pch

# Executables
*.exe
*.out
*.app

# Fortran module files
*.mod
*.smod

# Dependencies folder: ignore loose files but keep submodules
dependencies/*
!dependencies/*/
